@page "/process/crm"
@using WebUI.Services
@inject ProjectService ProjectService
@inject OptimizationService OptimizationService
@inject CrmService CrmService
@inject PivotService PivotService
@inject CorrectionService CorrectionService
@inject ISnackbar Snackbar

<PageTitle>ICP - CRM Calibration</PageTitle>

@if (_isLoading)
{
    <div class="loading-overlay">
        <MudPaper Elevation="4" Class="pa-6 d-flex flex-column align-center">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Class="mt-4">Processing...</MudText>
        </MudPaper>
    </div>
}

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    @* --- 1. هدر استاندارد (دقیقاً مشابه سایر صفحات) --- *@
    <MudPaper Elevation="0" Class="pa-4 mb-4 custom-card-all">
        <div class="d-flex justify-space-between align-center flex-wrap gap-2">
            <div>
                <MudText Typo="Typo.h4" Class="fw-bold h4-title">CRM Calibration</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary p-description">
                    @if (!string.IsNullOrEmpty(_projectName))
                    {
                        <span>Project: <strong>@_projectName</strong> | </span>
                    }
                    Optimize Blank & Scale using Differential Evolution algorithm
                </MudText>
            </div>
            <ProcessNav CurrentStep="crm" />
        </div>
    </MudPaper>

    @* --- 2. بخش کنترل‌های دسکتاپ (Pivot Controls) --- *@
    <MudPaper Elevation="0" Class="pa-3 mb-3 custom-card-all" Style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
        <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold" Style="color: #d81b60;">Pivot Controls</MudText>
        <div class="d-flex align-center gap-2 flex-wrap">

            @* دکمه اصلی عملیات *@
            <MudButton Variant="Variant.Filled" Class="btn-desktop-green" OnClick="StartCheckCrmProcess">
                Check CRM
            </MudButton>

            <MudButton Variant="Variant.Filled" Class="btn-desktop-green">
                Manual CRM
            </MudButton>

            <div class="d-flex align-center gap-1 mx-2 p-control-group">
                <MudText Typo="Typo.caption" Style="white-space:nowrap;">CRM Range (%):</MudText>
                <MudNumericField @bind-Value="_minDiff" Variant="Variant.Outlined" Margin="Margin.Dense" Class="input-tiny" HideSpinButtons="true" />
                <MudText Typo="Typo.caption">to</MudText>
                <MudNumericField @bind-Value="_maxDiff" Variant="Variant.Outlined" Margin="Margin.Dense" Class="input-tiny" HideSpinButtons="true" />
            </div>

            <div class="d-flex align-center gap-1 mx-2 p-control-group">
                <MudText Typo="Typo.caption" Style="white-space:nowrap;">Decimals:</MudText>
                <MudSelect T="int" @bind-Value="_decimalPlaces" Variant="Variant.Outlined" Margin="Margin.Dense" Class="input-tiny" Style="min-width:60px;">
                    <MudSelectItem Value="1">1</MudSelectItem>
                    <MudSelectItem Value="2">2</MudSelectItem>
                    <MudSelectItem Value="3">3</MudSelectItem>
                </MudSelect>
            </div>

            <MudButton Variant="Variant.Filled" Class="btn-desktop-green">
                Clear CRM
            </MudButton>

            <MudButton Variant="Variant.Filled" Class="btn-desktop-green" OnClick="RunOptimization">
                Calib
            </MudButton>

            <MudButton Variant="Variant.Filled" Class="btn-desktop-green">
                Export
            </MudButton>
        </div>
    </MudPaper>

    @* --- 3. جدول داده‌ها --- *@
    <MudPaper Elevation="0" Class="pa-0 custom-card-all">

        @if (_pivotData != null)
        {
            <div style="overflow-x: auto;">
                <MudTable Items="@_pivotData.Rows"
                          Hover="true"
                          Striped="true"
                          Dense="true"
                          FixedHeader="true"
                          Height="600px"
                          RowsPerPage="50"
                          Class="crm-desktop-table"
                          Elevation="0">
                    <HeaderContent>
                        <MudTh Style="position: sticky; left: 0; background: white; z-index: 2; min-width: 150px;">Solution Label</MudTh>
                        @foreach (var col in _displayColumns)
                        {
                            <MudTh>@col</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="position: sticky; left: 0; background: white; z-index: 1; font-weight: 600; border-right: 1px solid #eee;">
                            @if (_crmSelectionRows.Any(c => c.SolutionLabel == context.SolutionLabel))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Small" Color="Color.Success" Class="me-1" Style="font-size: 14px;" />
                            }
                            @context.SolutionLabel
                        </MudTd>
                        @foreach (var col in _displayColumns)
                        {
                            <MudTd>
                                @if (context.Values.TryGetValue(col, out var val) && val.HasValue)
                                {
                                    @val.Value.ToString($"F{_decimalPlaces}")
                                }
                                else
                                {
                                    <span class="mud-text-disabled">-</span>
                                }
                            </MudTd>
                        }
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </div>
        }
        else
        {
            <div class="d-flex flex-column justify-center align-center py-8" style="min-height: 300px;">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Class="mb-4" Style="font-size: 48px; opacity: 0.3;" />
                <MudText Typo="Typo.h6" Class="mb-2">No Data Loaded</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Please ensure a project is selected.</MudText>
            </div>
        }
    </MudPaper>

</MudContainer>

@* --- Dialog Wizard (بدون تغییر) --- *@
<MudDialog @bind-Visible="_isCrmDialogVisible" Options="new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Class="me-2" />
            Select CRM for @_currentConflictRow?.SolutionLabel
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">Multiple CRMs found. Please select one:</MudText>
        @if (_currentConflictRow != null)
        {
            @* استفاده از key باعث بازنشانی کامل وضعیت رادیوها در هر مرحله می‌شود *@
            <div @key="_currentStepKey">
                <MudRadioGroup @bind-Value="_tempSelectedCrmOption">
                    @foreach (var opt in GetRowAllOptions(_currentConflictRow))
                    {
                        <MudRadio Value="@opt" Color="Color.Success" Dense="true">@opt</MudRadio>
                    }
                </MudRadioGroup>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="me-auto mud-text-secondary">
            Remaining: @_conflictQueue.Count
        </MudText>

        <MudButton OnClick="CancelCrmProcess" Variant="Variant.Text" Color="Color.Error">Cancel</MudButton>

        <MudButton OnClick="ConfirmCrmSelection" Variant="Variant.Filled" Color="Color.Success">Confirm</MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* استایل دکمه‌های سبز دسکتاپی */
    .btn-desktop-green {
        background-color: #2e7d32 !important;
        color: white !important;
        font-weight: 500;
        border-radius: 4px;
        font-size: 0.85rem;
        height: 36px;
    }

        .btn-desktop-green:hover {
            background-color: #1b5e20 !important;
        }

    /* اینپوت‌های کوچک */
    .input-tiny {
        width: 60px;
        background-color: white;
    }

        .input-tiny .mud-input-slot {
            padding: 4px 8px !important;
            font-size: 0.85rem;
        }

    /* تنظیمات جدول */
    .crm-desktop-table {
        border-radius: 4px;
        overflow: hidden;
    }

        .crm-desktop-table .mud-table-head .mud-table-cell {
            background-color: #f5f5f5;
            color: #424242;
            font-weight: 700;
            font-size: 0.75rem;
            padding: 8px;
            border-bottom: 2px solid #e0e0e0;
        }

        .crm-desktop-table .mud-table-body .mud-table-cell {
            padding: 4px 8px;
            font-size: 0.75rem;
            border-bottom: 1px solid #f0f0f0;
            border-right: 1px solid #f0f0f0;
        }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.2);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>